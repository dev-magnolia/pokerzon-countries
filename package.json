{
  "name": "@pokerzon/countries",
  "version": "0.1.0",
  "description": "Country reference data (ISO 3166, display names, flag emoji, currencies, translations) and helpers for all POKERZON projects.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "repository": { "type": "git", "url": "git+https://github.com/dev-magnolia/pokerzon-countries.git" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./country.json": "./data/country.json",
    "./usa.json": "./data/usa.json",
    "./package.json": "./package.json"
  },
  "files": ["dist", "data"],
  "engines": { "node": ">=18" },
  "scripts": {
    "gen": "node scripts/gen-data.mjs",
    "build": "npm run gen && tsc -p tsconfig.build.json",
    "typecheck": "npm run gen && tsc -p tsconfig.json",
    "test": "npm run gen && tsx --test test/*.test.ts",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
